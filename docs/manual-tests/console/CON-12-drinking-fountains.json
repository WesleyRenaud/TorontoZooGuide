{
  "id": "CON-12",
  "title": "Drinking fountains",
  "steps": [
    {
      "number": 1,
      "name": "Close fountains",
      "do": "**Close drinking fountains** for a window covering today; optional message.",
      "expect": "Success closed."
    },
    {
      "number": 2,
      "name": "Map markers/banners",
      "do": "On **Map**, set **Specific Map** to today. In **Filter:**, enable **Drinking Fountains**.",
      "expect": "Closed treatment and/or banners."
    },
    {
      "number": 3,
      "name": "Open fountains",
      "do": "**Open drinking fountains**.",
      "expect": "Success open."
    },
    {
      "number": 4,
      "name": "Map restored",
      "do": "On **Map**, set **Specific Map** to today.",
      "expect": "Fountains restored/open treatment."
    },
    {
      "number": 5,
      "name": "Filter toggle",
      "do": "Toggle Drinking Fountains filter off/on.",
      "expect": "Markers show/hide."
    }
  ]
}
