{
  "id": "CON-14",
  "title": "Create event",
  "steps": [
    {
      "number": 1,
      "name": "Create event",
      "do": "**Create event** with name, location, description, optional link, dates covering today.",
      "expect": "Success created."
    },
    {
      "number": 2,
      "name": "Map Events shows",
      "do": "Map Explore → **Events** on today.",
      "expect": "Event visible."
    },
    {
      "number": 3,
      "name": "Open link",
      "do": "If link present, open/check it.",
      "expect": "Link works or N/A."
    },
    {
      "number": 4,
      "name": "Outside range",
      "do": "Set map date outside event range.",
      "expect": "Event absent."
    },
    {
      "number": 5,
      "name": "Inside range again",
      "do": "Return **Specific Map** to today.",
      "expect": "Event present."
    },
    {
      "number": 6,
      "name": "Endability Notes",
      "do": "Check whether console can end/delete event.",
      "expect": "Notes."
    },
    {
      "number": 7,
      "name": "Pass",
      "do": "Create + map date gating verified.",
      "expect": "Pass."
    }
  ]
}
