{
  "id": "ITIN-12",
  "title": "Map path smoke on itinerary",
  "steps": [
    {
      "number": 1,
      "name": "Multi-stop planner",
      "do": "Ensure Day Planner has \u22652 scheduled stops.",
      "expect": "Pills visible."
    },
    {
      "number": 2,
      "name": "Walk path drawn",
      "do": "Inspect itinerary map.",
      "expect": "Walk path/route overlay drawn."
    },
    {
      "number": 3,
      "name": "Pan/zoom path",
      "do": "Pan/zoom the itinerary map.",
      "expect": "Path remains visible."
    },
    {
      "number": 4,
      "name": "Unschedule middle",
      "do": "Unschedule a middle stop.",
      "expect": "Path updates (not stale)."
    },
    {
      "number": 5,
      "name": "Unschedule all clears path",
      "do": "**Unschedule all items**.",
      "expect": "Walk path clears."
    }
  ]
}
