{
   "name": "toronto-zoo-guide",
   "private": true,
   "type": "module",
   "scripts": {
      "build": "npm run coverage && npm run lint && echo 'Build complete!' && node tools/coverageSummary.js --print-last-summary",
      "clean": "node tools/cleanBuildArtifacts.js",
      "coverage": "node tools/coverageSummary.js",
      "coverage:js": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='scripts/**/*.js' tests/frontend/frontend.test.mjs",
      "coverage:py": "COVERAGE_FILE=/tmp/tzg-python-coverage python3 -m pytest tests/backend --cov=api.connection --cov=api.server --cov=api.zoo --cov=api.seed --cov-report=term-missing",
      "clear:itinerary": "python3 -m api.seed.clear_user_itinerary_data",
      "clear:itinerary-config": "python3 -m api.seed.clear_user_itinerary_config",
      "lint": "npm run lint:js && npm run lint:py",
      "lint:js": "node tools/lint/jsFilenameStyle.js && node tools/lint/jsImportStyle.js && eslint scripts && echo 'All checks passed!'",
      "lint:py": "python3 tools/lint/pythonImportStyle.py && python3 tools/lint/pythonHouseStyle.py && ruff check .",
      "migrate": "python3 -m api.seed.migrations.runner",
      "seed": "python3 -m api.seed.migrations.runner && python3 -m api.seed.runner",
      "seed:schema": "python3 -m api.seed.create_schema",
      "seed:data": "python3 -m api.seed.seed_data",
      "test:js": "node --test --test-concurrency=1 tests/frontend/frontend.test.mjs tests/frontend/scheduleItemActions.test.mjs tests/frontend/itineraryService.test.mjs",
      "test:py": "python3 -m pytest tests/backend",
      "start": "python3 -m api.server"
   },
   "devDependencies": {
      "eslint": "^10.2.0"
   }
}
