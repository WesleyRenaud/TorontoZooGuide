{
   "name": "toronto-zoo-guide",
   "private": true,
   "type": "module",
   "scripts": {
      "build": "npm run coverage && npm run lint && echo 'Build complete!' && node tools/coverageSummary.js --print-last-summary",
      "clean": "node tools/cleanBuildArtifacts.js",
      "coverage": "node tools/coverageSummary.js",
      "coverage:js": "node --test --experimental-test-coverage --test-coverage-include='scripts/**/*.js' tests/frontend/frontend.test.mjs",
      "coverage:py": "COVERAGE_FILE=/tmp/tzg-python-coverage python3 -m pytest tests/api -n auto --cov=api/animals --cov=api/attractions --cov=api/drinking_fountains --cov=api/events --cov=api/exhibits --cov=api/giftshops --cov=api/restaurants --cov=api/restrooms --cov=api/transportation --cov=api/updates --cov-report=term:skip-covered --cov-precision=2",
      "clear:itinerary": "python3 -m api.seed.user_itinerary_data_cleaner",
      "clear:itinerary-config": "python3 -m api.seed.user_itinerary_config_cleaner",
      "lint": "node tools/lint/mapSvgIntegrity.js && npm run lint:js && npm run lint:py",
      "lint:js": "node tools/lint/jsFilenameStyle.js && node tools/lint/jsImportStyle.js && eslint scripts && echo 'All checks passed!'",
      "lint:py": "python3 tools/lint/pythonImportStyle.py && python3 tools/lint/pythonHouseStyle.py && python3 tools/lint/pythonOneClassPerFile.py && python3 tools/lint/pythonNamespaceStyle.py && python3 tools/lint/jsonSeedStyle.py && ruff check .",
      "migrate": "python3 -m api.seed.migrations.migration_runner",
      "seed": "python3 -m api.seed.seed_runner",
      "seed:schema": "python3 -m api.seed.schema_applier",
      "seed:data": "python3 -m api.seed.seed_data_applier",
      "test:integration": "python3 -m pytest tests/backend/integration",
      "test:js": "node --test tests/frontend/frontend.test.mjs",
      "test:api": "python3 -m pytest tests/api -n auto",
      "test:py": "python3 -m pytest tests/api tests/backend -n auto",
      "start": "python3 -m api"
   },
   "devDependencies": {
      "eslint": "^10.2.0"
   }
}
